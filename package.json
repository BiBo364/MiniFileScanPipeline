{
  "name": "mini-file-scan-pipeline",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build -w @mini-scan/shared && npm run build -w @mini-scan/api && npm run build -w @mini-scan/worker",
    "start": "npm start -w @mini-scan/api",
    "start:worker": "npm start -w @mini-scan/worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  },
  "engines": {
    "node": ">=20"
  }
}
