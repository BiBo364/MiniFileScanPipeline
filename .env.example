# Copy to .env for local use. Do not commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=3000
HOST_API_PORT=3000

# Host-side URLs for running API/worker directly with npm.
DATABASE_URL=postgres://scans:scans@localhost:5432/scans
RABBITMQ_URL=amqp://miniscan:miniscan@localhost:5672

# Local Docker Compose defaults (development credentials only).
POSTGRES_USER=scans
POSTGRES_PASSWORD=scans
POSTGRES_DB=scans
RABBITMQ_USER=miniscan
RABBITMQ_PASSWORD=miniscan
COMPOSE_DATABASE_URL=postgres://scans:scans@postgres:5432/scans
COMPOSE_RABBITMQ_URL=amqp://miniscan:miniscan@rabbitmq:5672

# Used from Stage 2 onward; validated now so misconfig fails at boot
FILE_STORAGE_PATH=./data/uploads
MAX_UPLOAD_BYTES=10485760
SCAN_MAX_FILE_BYTES=10485760
# Comma-separated extra SHA-256 hashes to block. The EICAR test signature is built in.
SCAN_BLOCKLIST_SHA256=
DANGEROUS_FILE_EXTENSIONS=.exe,.dll,.bat,.cmd,.com,.scr,.js,.vbs,.ps1
SCAN_MAX_ATTEMPTS=3
SCAN_RETRY_BASE_DELAY_MS=1000
