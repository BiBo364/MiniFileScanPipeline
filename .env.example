# Copy to .env for local use. Do not commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=3000

# Local Docker Compose defaults (not production secrets)
DATABASE_URL=postgres://scans:scans@localhost:5432/scans
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Used from Stage 2 onward; validated now so misconfig fails at boot
FILE_STORAGE_PATH=./data/uploads
MAX_UPLOAD_BYTES=10485760
